{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "locallens-standalone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:standalone"],
      "port": 5180
    },
    {
      "name": "locallens-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5180
    },
    {
      "name": "locallens-ai",
      "runtimeExecutable": "services/ai/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "--factory", "app.main:create_app", "--app-dir", "services/ai", "--host", "127.0.0.1", "--port", "4200"],
      "port": 4200
    }
  ]
}
