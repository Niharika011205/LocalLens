# Copy to .env (git-ignored):  cp .env.example .env
# Every variable is validated when the API starts (apps/api/src/config.ts); invalid values stop the process.

NODE_ENV=development
# API_PORT overrides PORT (which hosting platforms and some dev tools inject). Production can just use PORT.
API_PORT=4100
LOG_LEVEL=info
LOG_PRETTY=true

# The browser origin of the web app. Used for the CSRF Origin check.
APP_ORIGIN=http://localhost:5180

# docker compose MongoDB (single-node replica set). directConnection is needed from the host machine.
MONGODB_URI=mongodb://localhost:27018/locallens?directConnection=true

# Rate limits shared across API instances. Use RATE_LIMIT_STORE=memory only for single-process development.
RATE_LIMIT_STORE=redis
REDIS_URL=redis://localhost:6380

# Must be true in production (https). False only for plain-http local development.
COOKIE_SECURE=false

# Set to the number of reverse proxies in front of the API (e.g. 1) in production so client IPs are correct.
TRUST_PROXY=false

# When set, the API also serves the built web app from this directory (single-origin deployment).
# STATIC_DIR=apps/web/dist

# Requests per minute per client IP across the API (raise behind a shared NAT, or for a load test).
RATE_LIMIT_GLOBAL_PER_MIN=300

# Reporters' photos on Cloudinary (public CDN, fast for every reader). Copy the "API environment variable" from
# your Cloudinary dashboard (Settings → API Keys). Unset: photos are stored in MongoDB instead.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=locallens

# Headlines from other news sites' public feeds (apps/api/src/modules/aggregator/sources.ts): checked every
# NEWS_IMPORT_INTERVAL_MIN minutes, kept for NEWS_KEEP_DAYS days. Only the headline, the feed's short summary,
# its photo and a link back are shown — never the full article.
# NEWS_IMPORT=true
# NEWS_IMPORT_INTERVAL_MIN=20
# NEWS_KEEP_DAYS=7

# Maps: place positions from OpenStreetMap Nominatim (one cached lookup per place, max 1 request/second).
# GEOCODER_ENABLED=true
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Quick posts (short news with a photo, live at once). A post reported by this many different readers is removed
# automatically (hidden; an editor can restore it). Self sign-up: ticking "I want to post news" gives reporter access.
# REPORTS_TO_REMOVE=10
# REPORTER_SELF_SIGNUP=true

# Two-step sign-in (authenticator apps). MFA_ENFORCE=true makes it mandatory for staff (editors, publishers,
# admins) before they can use staff tools; production requires it, plus the encryption key for the secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENFORCE=false
# MFA_ENCRYPTION_KEY=<32 random bytes, base64>

# ---- AI service (optional; leave AI_SERVICE_URL unset to run without AI checks and the assistant) ----
# The same token must be set for the AI service (services/ai/.env or its environment). 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AI_SERVICE_URL=http://127.0.0.1:4200
# AI_SERVICE_TOKEN=<random 32+ characters>
# Background verification may take minutes on a CPU model; the assistant has a reader waiting.
# AI_TIMEOUT_MS=600000
# AI_ASSISTANT_TIMEOUT_MS=120000
# Run the background job worker in this process (one per deployment is enough at pilot scale).
# JOBS_WORKER=true

# ---- Production values (set in your host's secret manager, not in a file) ----
# NODE_ENV=production
# APP_ORIGIN=https://<your-domain>
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/locallens
# REDIS_URL=rediss://<user>:<password>@<host>:<port>
# COOKIE_SECURE=true
# TRUST_PROXY=1
# LOG_PRETTY=false
# MFA_ENFORCE=true
# MFA_ENCRYPTION_KEY=<32 random bytes, base64 — losing it means every staff member must re-enrol>
