# Copy to services/ai/.env (git-ignored). Real environment variables override this file.
# Shared secret with the API (same value as AI_SERVICE_TOKEN in the root .env). 32+ random characters.
AI_SERVICE_TOKEN=<random 32+ characters>

# ollama (local, free) | anthropic (production quality) | none (fetching and guardrails only, no model)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# For LLM_PROVIDER=anthropic (set the key in your secret manager, not in a file, outside development)
# ANTHROPIC_API_KEY=<key>
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# LLM_TIMEOUT_S=300
# FETCH_TIMEOUT_S=10
# MAX_SOURCES=5
# MAX_CLAIMS_ASSESSED=3
