{
  "name": "@locallens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:standalone": "tsx --env-file-if-exists=../../.env src/dev-standalone.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "admin:promote": "tsx --env-file-if-exists=../../.env src/scripts/promote-admin.ts",
    "seed:dev": "tsx --env-file-if-exists=../../.env src/scripts/seed-dev.ts",
    "locations:import": "tsx --env-file-if-exists=../../.env src/scripts/import-lgd.ts",
    "locations:import-osm": "tsx --env-file-if-exists=../../.env src/scripts/import-osm.ts"
  },
  "dependencies": {
    "@locallens/contracts": "*",
    "@node-rs/argon2": "^2.2.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mongoose": "^8.16.0",
    "multer": "^2.5.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "^7.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
